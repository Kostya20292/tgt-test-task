{
  "name": "pervye-90",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/dev.ts",
    "build": "tsc -b && vite build",
    "build:vercel": "pnpm build && node scripts/build-vercel.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "db:push": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs push --force",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@tanstack/react-query": "^5.107.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.65.0",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "oxlint": "^1.90.0",
    "sass-embedded": "^1.108.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
